# ============================================
# 密钥与私密配置（最高优先级，绝不提交）
# ============================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
*credentials*.json
*serviceaccount*.json

# 密码 / 密钥类文件
*.password
passwords.txt
*secret*.json

# ============================================
# 依赖目录（体积巨大，可由 package.json 还原）
# ============================================
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
bower_components/
vendor/

# ============================================
# 构建产物（可重新生成）
# ============================================
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# ============================================
# 本地数据库文件（含本地数据，绝不提交）
# ============================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.mdb
*.accdb
*.dump
*.sql.gz

# ============================================
# 日志（可能含请求参数、token 泄漏）
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# 运行时与缓存
# ============================================
.cache/
.temp/
.tmp/
tmp/
*.pid
*.pid.lock
*.seed
coverage/

# ============================================
# 编辑器与系统文件
# ============================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# 本地个人笔记（含临时想法，不进仓库）
# ============================================
*.local
.local/
NOTES.local.md
